---
// Sous-menu : toutes les pages du jeu de donnees de la page courante
import { navGroups, groupLinks, isActive, currentPath } from "../lib/navigation.js";

const path = currentPath(Astro.url);
const group = navGroups.find((g) => groupLinks(g).some((link) => isActive(link, path)));
---

{
  group && groupLinks(group).length > 1 && (
    <nav aria-label={`Pages ${group.label}`} class="border-b border-slate-200 bg-slate-50">
      <div class="mx-auto flex max-w-5xl flex-wrap gap-x-8 gap-y-3 px-5 py-3 sm:px-8">
        {group.sections.map((section) => (
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs uppercase tracking-wide text-slate-500">{section.title}</span>
            <ul class="m-0 flex list-none flex-wrap gap-1 p-0">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={isActive(link, path) ? "page" : undefined}
                    class="block border border-slate-300 bg-white px-3 py-1 text-sm text-slate-600 no-underline transition-colors hover:border-slate-500 hover:text-slate-900 aria-[current=page]:border-slate-900 aria-[current=page]:bg-slate-900 aria-[current=page]:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </nav>
  )
}
