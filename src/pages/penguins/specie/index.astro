---
import Layout from "../../../layouts/Layout.astro";
import { validPenguins } from "../../../lib/penguins.js";

// Liste des especes determinee automatiquement a partir des donnees
const species = [...new Set(validPenguins.map((p) => p.species))];
---

<Layout title="Especes" description="Liens vers la page de chaque espece de manchot.">
  <h1 class="mb-6 mt-0 text-3xl font-bold">Les especes</h1>

  <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
    {
      species.map((specie) => (
        <li>
          <a
            href={`/penguins/specie/${specie}/`}
            class="block border border-slate-300 px-4 py-2 text-slate-700 no-underline hover:border-slate-900 hover:text-slate-900"
          >
            {specie}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
